# ClimaSchool AI API — environment template.
# Copy to .env next to this file, fill in the real values, then: chmod 600 .env
# .env is read by app/config.py (pydantic-settings) and by the systemd unit.

# ── identity ─────────────────────────────────────────────────────────────────
# Shown in /health, / and the OpenAPI title.
APP_NAME="ClimaSchool AI API"
# "production" enables the startup guard that refuses to boot on a default SECRET_KEY.
ENVIRONMENT=production
# Mount point for every versioned router; nginx proxies this path through.
API_PREFIX=/api/v1

# ── database ─────────────────────────────────────────────────────────────────
# PostgreSQL via psycopg 3. Create the role and database before first boot.
DATABASE_URL=postgresql+psycopg://climaschool:CHANGE_ME@localhost:5432/climaschool

# ── security ─────────────────────────────────────────────────────────────────
# REQUIRED. Generate a fresh one per environment and never commit it:
#   openssl rand -hex 32
# Leaving this as the default makes the API refuse to start when ENVIRONMENT=production.
# Changing it invalidates every issued token, which is the intended panic button.
SECRET_KEY=generate-with-openssl-rand-hex-32
# Token lifetime in minutes; 720 = 12 hours, one working day for a reviewer.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── browser access ───────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser. Keep it tight —
# the console sends bearer tokens, so a stray wildcard origin is a real exposure.
CORS_ORIGINS=http://localhost:5173,https://climaschoolai.com,https://www.climaschoolai.com

# ── first administrator ──────────────────────────────────────────────────────
# On startup, if the users table is empty AND a password is set below, one admin
# account is created with this email.
BOOTSTRAP_ADMIN_EMAIL=ecolutionghana@gmail.com
# Set this ONCE for the very first boot, then log in, change the password via
# POST /api/v1/auth/change-password, DELETE THIS LINE and restart the service.
# Leaving a live password in .env means anyone with file access owns the admin account.
BOOTSTRAP_ADMIN_PASSWORD=
